FROM docker.io/library/node:22-bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates curl procps \
 && rm -rf /var/lib/apt/lists/*
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    CI=true
RUN corepack enable && corepack prepare pnpm@11 --activate \
 && mkdir -p /root/.config/pnpm \
 && printf 'storeDir: /pnpm-store\npackageImportMethod: copy\n' > /root/.config/pnpm/config.yaml
COPY template/package.json template/pnpm-lock.yaml template/pnpm-workspace.yaml /seed/
RUN cd /seed && pnpm fetch && pnpm store path && cd / && rm -rf /seed
WORKDIR /app
CMD ["sleep", "infinity"]
