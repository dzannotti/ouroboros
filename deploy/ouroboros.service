# systemd --user unit. Install:
#   cp deploy/ouroboros.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now ouroboros && loginctl enable-linger $USER
[Unit]
Description=Ouroboros AI app builder
After=network-online.target

[Service]
WorkingDirectory=%h/ouroboros
EnvironmentFile=%h/ouroboros/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
