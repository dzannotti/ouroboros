# --- Models (any OpenAI-compatible endpoint with tool calling: LiteLLM, vLLM, llama.cpp server, Ollama…) ---
AI_BASE_URL=http://localhost:4000/v1
AI_API_KEY=
# Models shown in the picker. Leave unset to read them from the endpoint (refreshed every 5 minutes):
# chat models from /models, with labels from LiteLLM's /model/info if you add, per model in the LiteLLM config,
#   model_info: { ouroboros: { label: "Fast", description: "Quick edits", default: true } }   (hidden: true hides one)
# Or pin the list here as "id:Label:description,id:Label":
# AI_MODELS=qwen3-coder:Coder:Fast,other-model:Big:Slower but more thorough
# Overrides the default model; otherwise the one flagged default, else the first.
# AI_DEFAULT_MODEL=
# Optional embeddings model (better file selection for large projects, icon-name repair)
# AI_EMBEDDING_MODEL=
# Send the prompting user's email to the endpoint in this header, for per-user usage tracking
# (e.g. LiteLLM reads X-OpenWebUI-User-Email as the end user). Unset sends nothing.
# AI_USER_HEADER=X-OpenWebUI-User-Email
# Bill each generated image to the prompting user as an image request at AI_BASE_URL, priced per megapixel by this price list entry.
# COMFY_BILLING_MODEL=z-image-turbo
# Thinking effort for the build agent: low | medium | high. Unset leaves the endpoint's default.
# Temperature, top-p and top-k are never sent, so the endpoint's defaults apply.
# AI_REASONING_EFFORT=medium
# Agent limits: max model calls per message, and prompt token budget before compaction
# AI_MAX_STEPS=300
# AI_CONTEXT_BUDGET=170000

# --- Web search (optional): a SearXNG instance with the JSON format enabled (search.formats: [html, json]) ---
# Lets the agent look up docs and facts with web_search alongside fetch_url.
# SEARXNG_URL=http://searxng:8080

# --- Image generation (optional): ComfyUI with a Z-Image Turbo checkpoint ---
# COMFY_URL=http://comfyui:8188
# COMFY_MODEL=z_image_turbo_bf16.safetensors
# COMFY_TEXT_ENCODER=qwen_3_4b.safetensors
# COMFY_VAE=ae.safetensors

# --- Server ---
# PORT=8787
# PREVIEW_PORT=8788
# Public preview origin if it differs from <app host>:PREVIEW_PORT (e.g. behind a reverse proxy)
# PREVIEW_URL=https://preview.example.com
# DATA_DIR=./data
# SANDBOX_IDLE_MINUTES=20
# CHROME_PATH=/usr/bin/chromium

# --- Database for Ouroboros itself ---
# Leave unset locally to auto-run a podman container (ouroboros-db).
# DATABASE_URL=postgres://ouroboros:password@db-host:5432/ouroboros
# Connect read-only (e.g. to inspect a production database from a dev machine):
# DB_READONLY=1

# --- Containers ---
# CONTAINER_CLI=podman            # or docker (auto-detected)
# When Ouroboros itself runs in a container (see deploy/compose.example.yaml):
# CONTAINER_NETWORK=ouroboros
# HOST_DATA_DIR=/srv/ouroboros/data
# OUROBOROS_HOSTNAME=ouroboros

# --- Auth ---
# Leave OIDC_* unset for local development (auto-signed-in admin).
# PUBLIC_URL=https://ouroboros.example.com
# OIDC_ISSUER=https://auth.example.com/application/o/ouroboros/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# SESSION_SECRET=                # openssl rand -hex 32
# OIDC_DEFAULT_ROLE=none         # or "user" to let any signed-in account in
# Forward-auth alternative (headers are only trusted from these proxy IPs):
# TRUSTED_PROXIES=10.0.0.2
